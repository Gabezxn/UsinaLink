# Cabeçalhos de segurança do Cloudflare Pages (e de qa/env/static.mjs nos testes locais).
# O CSP não permite scripts inline: só arquivos do próprio site e o VLibras (acessibilidade em Libras).
# connect-src inclui a API no Render; http://localhost:3000 serve apenas ao desenvolvimento local.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://vlibras.gov.br https://*.vlibras.gov.br https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://vlibras.gov.br https://*.vlibras.gov.br https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https://vlibras.gov.br https://*.vlibras.gov.br https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net https://usinalink-orbz.onrender.com http://localhost:3000 https://vlibras.gov.br https://*.vlibras.gov.br https://*.gov.br data: blob:; frame-src https://vlibras.gov.br https://*.vlibras.gov.br; worker-src 'self' blob:; media-src 'self' data: blob: https://vlibras.gov.br https://*.vlibras.gov.br; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
