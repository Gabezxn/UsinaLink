# Cabeçalhos de segurança do Cloudflare Pages (e de qa/env/static.mjs nos testes locais).
# O CSP não permite scripts inline: só arquivos do próprio site e o VLibras (acessibilidade em Libras).
# connect-src inclui a API no Render; http://localhost:3000 serve apenas ao desenvolvimento local.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://vlibras.gov.br https://*.vlibras.gov.br; style-src 'self' 'unsafe-inline' https://vlibras.gov.br https://*.vlibras.gov.br; img-src 'self' data: blob: https:; font-src 'self' data: https://vlibras.gov.br https://*.vlibras.gov.br; connect-src 'self' https://usinalink-orbz.onrender.com http://localhost:3000 https://vlibras.gov.br https://*.vlibras.gov.br; frame-src https://vlibras.gov.br https://*.vlibras.gov.br; media-src 'self' data: blob: https://vlibras.gov.br https://*.vlibras.gov.br; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
