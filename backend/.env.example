PORT=3000

# DB_TYPE define o banco: "mysql" (XAMPP local) ou "postgres" (Supabase).
DB_TYPE=mysql

# --- Exemplo local com MySQL (XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=usinalink
DB_SSL=false

# --- Exemplo em producao com Supabase (Postgres) ---
# DB_TYPE=postgres
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=a-senha-que-voce-definiu-no-supabase
# DB_NAME=postgres
# DB_SSL=true

# Em desenvolvimento o TypeORM cria/atualiza as tabelas sozinho.
# Em producao, prefira migrations e deixe isso como "false" depois da primeira subida.
DB_SYNCHRONIZE=true

# Troque por um valor aleatorio e secreto antes de ir para producao.
JWT_SECRET=usinalink-dev-secret

# Dominios que podem chamar a API, separados por virgula.
# Adicione aqui o dominio do Vercel quando publicar o site.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
